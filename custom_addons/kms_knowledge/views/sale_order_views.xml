<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Base Sales Order Tree View to remove all sum fields -->
        <record id="sale_order_tree_inherit_all" model="ir.ui.view">
            <name>sale.order.tree.inherit.all</name>
            <model>sale.order</model>
            <inherit_id ref="sale.sale_order_tree"/>
            <arch type="xml">
                <xpath expr="//field[@name='amount_untaxed']" position="attributes">
                    <attribute name="sum" type="delete"/>
                </xpath>
                <xpath expr="//field[@name='amount_tax']" position="attributes">
                    <attribute name="sum" type="delete"/>
                </xpath>
                <xpath expr="//field[@name='amount_total']" position="attributes">
                    <attribute name="sum" type="delete"/>
                </xpath>
            </arch>
        </record>
    </data>
</odoo>
