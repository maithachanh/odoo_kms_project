<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_kms_knowledge" model="ir.module.category">
            <field name="name">KMS Knowledge</field>
            <field name="sequence">25</field>
        </record>

        <record id="privilege_kms_knowledge" model="res.groups.privilege">
            <field name="name">KMS Knowledge Privilege</field>
            <field name="category_id" ref="module_category_kms_knowledge"/>
        </record>

        <record id="group_kms_it_staff" model="res.groups">
            <field name="name">KMS IT Staff</field>
            <field name="privilege_id" ref="privilege_kms_knowledge"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_kms_hr_manager" model="res.groups">
            <field name="name">KMS HR Manager</field>
            <field name="privilege_id" ref="privilege_kms_knowledge"/>
            <field name="implied_ids" eval="[(4, ref('group_kms_it_staff'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_kms_hr_manager'))]"/>
        </record>

        <record id="rule_kms_article_public_read" model="ir.rule">
            <field name="name">KMS articles: public workspace access</field>
            <field name="model_id" ref="model_kms_knowledge_article"/>
            <field name="domain_force">[('access_role', '=', 'public')]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_kms_article_it_staff_access" model="ir.rule">
            <field name="name">KMS articles: IT staff workspace access</field>
            <field name="model_id" ref="model_kms_knowledge_article"/>
            <field name="domain_force">[('access_role', 'in', ['public', 'it_staff'])]</field>
            <field name="groups" eval="[(4, ref('group_kms_it_staff'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_kms_article_hr_manager_access" model="ir.rule">
            <field name="name">KMS articles: HR manager full access</field>
            <field name="model_id" ref="model_kms_knowledge_article"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_kms_hr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rule to Isolate Chat History by User -->
        <record id="rule_kms_ai_agent_chat_line_personal" model="ir.rule">
            <field name="name">KMS AI Agent Chat Line: personal history</field>
            <field name="model_id" ref="model_kms_ai_agent_chat_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
